digraph erd {
  graph [rankdir=LR, fontname="Carlito", nodesep=0.5, ranksep=0.9, splines=true, pad=0.5, bgcolor="white", labelloc=t, label=<<FONT POINT-SIZE="28" COLOR="#1F3864"><B>Modèle entité-relation de la base transactionnelle</B></FONT><BR/><FONT POINT-SIZE="15" COLOR="#595959">12 tables en troisième forme normale - PK : clé primaire, FK : clé étrangère, UQ : valeur unique - patte de corbeau : plusieurs, trait : un, cercle : facultatif</FONT><BR/> >];
  node [shape=plain, fontname="Carlito", fontsize=12];
  edge [color="#1F3864", penwidth=1.5, arrowsize=1.1, dir=both, fontname="Carlito"];
  pays [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">RÉFÉRENTIEL</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>pays</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="code_pays_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>code_pays</B></TD><TD ALIGN="LEFT" PORT="code_pays_d"><FONT COLOR="#595959">CHAR(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="nom_g"></TD><TD ALIGN="LEFT">nom</TD><TD ALIGN="LEFT" PORT="nom_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="region_g"></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT" PORT="region_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR></TABLE>>];
  devises [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">RÉFÉRENTIEL</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>devises</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="code_devise_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>code_devise</B></TD><TD ALIGN="LEFT" PORT="code_devise_d"><FONT COLOR="#595959">CHAR(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="nom_g"></TD><TD ALIGN="LEFT">nom</TD><TD ALIGN="LEFT" PORT="nom_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR></TABLE>>];
  taux_change [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">RÉFÉRENTIEL</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>taux_change</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="code_devise_g"><FONT COLOR="#1F3864"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT"><B>code_devise</B></TD><TD ALIGN="LEFT" PORT="code_devise_d"><FONT COLOR="#595959">CHAR(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_taux_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>date_taux</B></TD><TD ALIGN="LEFT" PORT="date_taux_d"><FONT COLOR="#595959">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="taux_vers_eur_g"></TD><TD ALIGN="LEFT">taux_vers_eur</TD><TD ALIGN="LEFT" PORT="taux_vers_eur_d"><FONT COLOR="#595959">NUMERIC(18,8)</FONT></TD></TR></TABLE>>];
  marchands [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">ACTEUR</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>marchands</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="marchand_id_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>marchand_id</B></TD><TD ALIGN="LEFT" PORT="marchand_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="raison_sociale_g"></TD><TD ALIGN="LEFT">raison_sociale</TD><TD ALIGN="LEFT" PORT="raison_sociale_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="code_pays_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">code_pays</TD><TD ALIGN="LEFT" PORT="code_pays_d"><FONT COLOR="#595959">CHAR(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="categorie_g"></TD><TD ALIGN="LEFT">categorie</TD><TD ALIGN="LEFT" PORT="categorie_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_creation_g"></TD><TD ALIGN="LEFT">date_creation</TD><TD ALIGN="LEFT" PORT="date_creation_d"><FONT COLOR="#595959">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
  clients [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">ACTEUR</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>clients</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="client_id_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>client_id</B></TD><TD ALIGN="LEFT" PORT="client_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="email_chiffre_g"></TD><TD ALIGN="LEFT">email_chiffre<BR/><FONT COLOR="#C55A11" POINT-SIZE="10"><I>chiffré (pgcrypto)</I></FONT></TD><TD ALIGN="LEFT" PORT="email_chiffre_d"><FONT COLOR="#595959">BYTEA</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="code_pays_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">code_pays</TD><TD ALIGN="LEFT" PORT="code_pays_d"><FONT COLOR="#595959">CHAR(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_creation_g"></TD><TD ALIGN="LEFT">date_creation</TD><TD ALIGN="LEFT" PORT="date_creation_d"><FONT COLOR="#595959">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
  moyens_paiement [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">ACTEUR</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>moyens_paiement</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="moyen_paiement_id_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>moyen_paiement_id</B></TD><TD ALIGN="LEFT" PORT="moyen_paiement_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="client_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">client_id</TD><TD ALIGN="LEFT" PORT="client_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="type_g"></TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT" PORT="type_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="marque_g"></TD><TD ALIGN="LEFT">marque</TD><TD ALIGN="LEFT" PORT="marque_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="quatre_derniers_g"></TD><TD ALIGN="LEFT">quatre_derniers</TD><TD ALIGN="LEFT" PORT="quatre_derniers_d"><FONT COLOR="#595959">CHAR(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="jeton_g"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">jeton<BR/><FONT COLOR="#C55A11" POINT-SIZE="10"><I>jeton, jamais le numéro</I></FONT></TD><TD ALIGN="LEFT" PORT="jeton_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR></TABLE>>];
  produits [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">CATALOGUE</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>produits</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="produit_id_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>produit_id</B></TD><TD ALIGN="LEFT" PORT="produit_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="marchand_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">marchand_id</TD><TD ALIGN="LEFT" PORT="marchand_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="nom_g"></TD><TD ALIGN="LEFT">nom</TD><TD ALIGN="LEFT" PORT="nom_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="prix_g"></TD><TD ALIGN="LEFT">prix</TD><TD ALIGN="LEFT" PORT="prix_d"><FONT COLOR="#595959">NUMERIC(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="code_devise_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">code_devise</TD><TD ALIGN="LEFT" PORT="code_devise_d"><FONT COLOR="#595959">CHAR(3)</FONT></TD></TR></TABLE>>];
  abonnements [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">CATALOGUE</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>abonnements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="abonnement_id_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>abonnement_id</B></TD><TD ALIGN="LEFT" PORT="abonnement_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="client_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">client_id</TD><TD ALIGN="LEFT" PORT="client_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="produit_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">produit_id</TD><TD ALIGN="LEFT" PORT="produit_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="statut_g"></TD><TD ALIGN="LEFT">statut</TD><TD ALIGN="LEFT" PORT="statut_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_debut_g"></TD><TD ALIGN="LEFT">date_debut</TD><TD ALIGN="LEFT" PORT="date_debut_d"><FONT COLOR="#595959">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_fin_g"></TD><TD ALIGN="LEFT">date_fin</TD><TD ALIGN="LEFT" PORT="date_fin_d"><FONT COLOR="#595959">DATE</FONT></TD></TR></TABLE>>];
  transactions [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">PAIEMENT</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="transaction_id_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>transaction_id</B></TD><TD ALIGN="LEFT" PORT="transaction_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="marchand_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">marchand_id</TD><TD ALIGN="LEFT" PORT="marchand_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="client_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">client_id</TD><TD ALIGN="LEFT" PORT="client_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="moyen_paiement_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">moyen_paiement_id</TD><TD ALIGN="LEFT" PORT="moyen_paiement_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="produit_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">produit_id</TD><TD ALIGN="LEFT" PORT="produit_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="abonnement_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">abonnement_id</TD><TD ALIGN="LEFT" PORT="abonnement_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="montant_g"></TD><TD ALIGN="LEFT">montant</TD><TD ALIGN="LEFT" PORT="montant_d"><FONT COLOR="#595959">NUMERIC(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="code_devise_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">code_devise</TD><TD ALIGN="LEFT" PORT="code_devise_d"><FONT COLOR="#595959">CHAR(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="statut_g"></TD><TD ALIGN="LEFT">statut</TD><TD ALIGN="LEFT" PORT="statut_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_heure_g"></TD><TD ALIGN="LEFT">date_heure</TD><TD ALIGN="LEFT" PORT="date_heure_d"><FONT COLOR="#595959">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="adresse_ip_g"></TD><TD ALIGN="LEFT">adresse_ip<BR/><FONT COLOR="#C55A11" POINT-SIZE="10"><I>exclue du flux</I></FONT></TD><TD ALIGN="LEFT" PORT="adresse_ip_d"><FONT COLOR="#595959">INET</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="pays_ip_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">pays_ip</TD><TD ALIGN="LEFT" PORT="pays_ip_d"><FONT COLOR="#595959">CHAR(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="type_appareil_g"></TD><TD ALIGN="LEFT">type_appareil</TD><TD ALIGN="LEFT" PORT="type_appareil_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="score_anomalie_g"></TD><TD ALIGN="LEFT">score_anomalie</TD><TD ALIGN="LEFT" PORT="score_anomalie_d"><FONT COLOR="#595959">NUMERIC(5,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_maj_g"></TD><TD ALIGN="LEFT">date_maj</TD><TD ALIGN="LEFT" PORT="date_maj_d"><FONT COLOR="#595959">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
  remboursements [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">APRÈS-VENTE</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>remboursements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="remboursement_id_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>remboursement_id</B></TD><TD ALIGN="LEFT" PORT="remboursement_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="transaction_id_g"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">transaction_id</TD><TD ALIGN="LEFT" PORT="transaction_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="montant_g"></TD><TD ALIGN="LEFT">montant</TD><TD ALIGN="LEFT" PORT="montant_d"><FONT COLOR="#595959">NUMERIC(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="motif_g"></TD><TD ALIGN="LEFT">motif</TD><TD ALIGN="LEFT" PORT="motif_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_remboursement_g"></TD><TD ALIGN="LEFT">date_remboursement</TD><TD ALIGN="LEFT" PORT="date_remboursement_d"><FONT COLOR="#595959">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
  litiges [label=<<TABLE BORDER="1" COLOR="#1F3864" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#DEEBF7"><TR><TD COLSPAN="3" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">APRÈS-VENTE</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>litiges</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="litige_id_g"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>litige_id</B></TD><TD ALIGN="LEFT" PORT="litige_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="transaction_id_g"><FONT COLOR="#1F3864"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT">transaction_id</TD><TD ALIGN="LEFT" PORT="transaction_id_d"><FONT COLOR="#595959">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="motif_g"></TD><TD ALIGN="LEFT">motif</TD><TD ALIGN="LEFT" PORT="motif_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="statut_g"></TD><TD ALIGN="LEFT">statut</TD><TD ALIGN="LEFT" PORT="statut_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_ouverture_g"></TD><TD ALIGN="LEFT">date_ouverture</TD><TD ALIGN="LEFT" PORT="date_ouverture_d"><FONT COLOR="#595959">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
  journal_audit [label=<<TABLE BORDER="1" COLOR="#44546A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E7EAF0"><TR><TD COLSPAN="3" BGCOLOR="#44546A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="10">AUDIT</FONT><BR/><FONT COLOR="white" POINT-SIZE="15"><B>journal_audit</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="audit_id_g"><FONT COLOR="#44546A"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>audit_id</B></TD><TD ALIGN="LEFT" PORT="audit_id_d"><FONT COLOR="#595959">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="table_cible_g"></TD><TD ALIGN="LEFT">table_cible</TD><TD ALIGN="LEFT" PORT="table_cible_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="operation_g"></TD><TD ALIGN="LEFT">operation</TD><TD ALIGN="LEFT" PORT="operation_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="identifiant_ligne_g"></TD><TD ALIGN="LEFT">identifiant_ligne</TD><TD ALIGN="LEFT" PORT="identifiant_ligne_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="utilisateur_bd_g"></TD><TD ALIGN="LEFT">utilisateur_bd</TD><TD ALIGN="LEFT" PORT="utilisateur_bd_d"><FONT COLOR="#595959">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="date_action_g"></TD><TD ALIGN="LEFT">date_action</TD><TD ALIGN="LEFT" PORT="date_action_d"><FONT COLOR="#595959">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="anciennes_valeurs_g"></TD><TD ALIGN="LEFT">anciennes_valeurs</TD><TD ALIGN="LEFT" PORT="anciennes_valeurs_d"><FONT COLOR="#595959">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38" PORT="nouvelles_valeurs_g"></TD><TD ALIGN="LEFT">nouvelles_valeurs</TD><TD ALIGN="LEFT" PORT="nouvelles_valeurs_d"><FONT COLOR="#595959">JSONB</FONT></TD></TR></TABLE>>];
  taux_change:code_devise_d:e -> devises:code_devise_g:w [arrowtail=crowtee, arrowhead=teetee];
  marchands:code_pays_d:e -> pays:code_pays_g:w [arrowtail=crowtee, arrowhead=teetee];
  clients:code_pays_d:e -> pays:code_pays_g:w [arrowtail=crowtee, arrowhead=teetee];
  moyens_paiement:client_id_d:e -> clients:client_id_g:w [arrowtail=crowtee, arrowhead=teetee];
  produits:marchand_id_d:e -> marchands:marchand_id_g:w [arrowtail=crowtee, arrowhead=teetee];
  produits:code_devise_d:e -> devises:code_devise_g:w [arrowtail=crowtee, arrowhead=teetee];
  abonnements:client_id_d:e -> clients:client_id_g:w [arrowtail=crowtee, arrowhead=teetee];
  abonnements:produit_id_d:e -> produits:produit_id_g:w [arrowtail=crowtee, arrowhead=teetee];
  transactions:marchand_id_d:e -> marchands:marchand_id_g:w [arrowtail=crowtee, arrowhead=teetee];
  transactions:client_id_d:e -> clients:client_id_g:w [arrowtail=crowtee, arrowhead=teetee];
  transactions:moyen_paiement_id_d:e -> moyens_paiement:moyen_paiement_id_g:w [arrowtail=crowtee, arrowhead=teetee];
  transactions:produit_id_d:e -> produits:produit_id_g:w [arrowtail=crowodot, arrowhead=teetee];
  transactions:abonnement_id_d:e -> abonnements:abonnement_id_g:w [arrowtail=crowodot, arrowhead=teetee];
  transactions:code_devise_d:e -> devises:code_devise_g:w [arrowtail=crowtee, arrowhead=teetee];
  transactions:pays_ip_d:e -> pays:code_pays_g:w [arrowtail=crowodot, arrowhead=teetee];
  remboursements:transaction_id_d:e -> transactions:transaction_id_g:w [arrowtail=crowtee, arrowhead=teetee];
  litiges:transaction_id_d:e -> transactions:transaction_id_g:w [arrowtail=teeodot, arrowhead=teetee];
  note_integrite [label=<<TABLE BORDER="1" COLOR="#7F7F7F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F2F2F2"><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864" POINT-SIZE="13"><B>Intégrité renforcée</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Clés étrangères composées :</TD></TR><TR><TD ALIGN="LEFT">(moyen_paiement_id, client_id) : un paiement n'utilise que</TD></TR><TR><TD ALIGN="LEFT">une carte de son propre client ;</TD></TR><TR><TD ALIGN="LEFT">(produit_id, marchand_id) : un produit vendu par le marchand payé ;</TD></TR><TR><TD ALIGN="LEFT">(abonnement_id, client_id) : un abonnement du client payeur.</TD></TR><TR><TD ALIGN="LEFT">Contrainte d'unicité : un seul litige par paiement.</TD></TR><TR><TD ALIGN="LEFT">Déclencheurs : remboursement refusé au-delà du montant payé,</TD></TR><TR><TD ALIGN="LEFT">statut du paiement mis à jour (remboursé, contesté),</TD></TR><TR><TD ALIGN="LEFT">abonnement cohérent avec le produit ;</TD></TR><TR><TD ALIGN="LEFT">remboursements non modifiables une fois enregistrés.</TD></TR></TABLE>>];
  note_audit [label=<<TABLE BORDER="1" COLOR="#7F7F7F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F2F2F2"><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864" POINT-SIZE="13"><B>Journal d'audit</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Alimenté par déclencheurs sur les tables sensibles ;</TD></TR><TR><TD ALIGN="LEFT">anciennes et nouvelles valeurs, compte et date de l'action.</TD></TR><TR><TD ALIGN="LEFT">Sans clé étrangère : il survit à la suppression des lignes.</TD></TR><TR><TD ALIGN="LEFT">Non modifiable : toute mise à jour ou suppression est refusée.</TD></TR></TABLE>>];
  { rank=same; journal_audit; note_audit; remboursements; litiges; note_integrite; }
  journal_audit -> note_audit -> remboursements -> litiges -> note_integrite [style=invis];
  { rank=same; moyens_paiement; abonnements; }
  { rank=same; clients; produits; }
  { rank=same; marchands; taux_change; }
  { rank=same; pays; devises; }
}