# Modèle de configuration de l'environnement local.
# La copie renseignée porte le nom .env et reste exclue du dépôt Git.
# Mots de passe composés uniquement de lettres et de chiffres (réutilisés dans des URL de connexion).

OLTP_ADMIN_USER=stripe_admin
OLTP_ADMIN_PASSWORD=a_definir
REPLICATION_PASSWORD=a_definir

DWH_ADMIN_USER=dwh_admin
DWH_ADMIN_PASSWORD=a_definir

AIRFLOW_DB_PASSWORD=a_definir

MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=a_definir

MONGO_EXPRESS_USER=consultation
MONGO_EXPRESS_PASSWORD=a_definir

# Clé de chiffrement symétrique des adresses e-mail (pgcrypto)
CLE_CHIFFREMENT_EMAIL=a_definir

# Mot de passe du compte de capture des changements (Debezium)
CDC_PASSWORD=a_definir

# Comptes de service (contrôle d'accès par rôles), un mot de passe par compte
# Base transactionnelle
APP_PAIEMENTS_PASSWORD=a_definir
FLUX_TEMPS_REEL_PASSWORD=a_definir
ORCHESTRATEUR_OLTP_PASSWORD=a_definir
# Entrepôt analytique
CHARGEMENT_DWH_PASSWORD=a_definir
ANALYSTE_DWH_PASSWORD=a_definir
AUDITEUR_DWH_PASSWORD=a_definir
# Base NoSQL
MONGO_GENERATEUR_PASSWORD=a_definir
MONGO_FLUX_PASSWORD=a_definir
MONGO_ORCHESTRATEUR_PASSWORD=a_definir

# Supervision (Grafana) : compte administrateur de l'interface et comptes de lecture seule
GRAFANA_ADMIN_PASSWORD=a_definir
SUPERVISION_OLTP_PASSWORD=a_definir
SUPERVISION_DWH_PASSWORD=a_definir
