    {
      "id": 11,
      "type": "stat",
      "title": "Connexions réseau non chiffrées",
      "description": "Nombre de connexions réseau à la base transactionnelle sans chiffrement TLS. La base les refuse ; toute valeur non nulle signalerait une règle d'accès modifiée.",
      "datasource": {
