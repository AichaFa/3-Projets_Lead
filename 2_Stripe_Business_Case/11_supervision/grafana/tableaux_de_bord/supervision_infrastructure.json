    {
      "id": 8,
      "type": "stat",
      "title": "Retard du réplica",
      "description": "Volume du journal des transactions que le réplica n'a pas encore rejoué. Un retard qui grandit expose à une perte de données en cas de bascule sur le réplica.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caisse_oltp"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 16
