        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "caisse_oltp"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE NOT s.ssl) AS \"Non chiffrées\"\nFROM pg_stat_activity a\nJOIN pg_stat_ssl s ON s.pid = a.pid\nWHERE a.client_addr IS NOT NULL"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Connexions réseau à la base transactionnelle",
      "description": "Comptes connectés à la base transactionnelle, nombre de connexions, chiffrement et version du protocole. Un compte inattendu ou une connexion non chiffrée appelle une vérification.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caisse_oltp"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "caisse_oltp"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.usename AS \"Compte\",\n       count(*) AS \"Connexions\",\n       CASE WHEN bool_and(s.ssl) THEN 'oui' ELSE 'non' END AS \"Toutes chiffrées\",\n       string_agg(DISTINCT s.version, ', ') AS \"Protocole\"\nFROM pg_stat_activity a\nJOIN pg_stat_ssl s ON s.pid = a.pid\nWHERE a.client_addr IS NOT NULL\nGROUP BY a.usename\nORDER BY a.usename"
        }
      ]
    },
