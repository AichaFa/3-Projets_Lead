          "rawQuery": true,
          "rawSql": "SELECT pg_wal_lsn_diff(pg_current_wal_lsn(), confirmed_flush_lsn) AS \"Retard\"\nFROM pg_replication_slots\nWHERE slot_name = 'slot_stripe_cdc'"
        }
      ]
