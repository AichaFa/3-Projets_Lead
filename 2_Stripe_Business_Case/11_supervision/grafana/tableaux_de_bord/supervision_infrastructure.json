        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "caisse_oltp"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pg_wal_lsn_diff(pg_current_wal_lsn(), replay_lsn) AS \"Retard\"\nFROM pg_stat_replication\nWHERE pid NOT IN (SELECT active_pid FROM pg_replication_slots WHERE slot_type = 'logical' AND active_pid IS NOT NULL)"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Retard de lecture de Debezium",
      "description": "Volume du journal conservé pour Debezium et pas encore lu. Il est plafonné à 2 Go (max_slot_wal_keep_size) : au-delà, la capture serait interrompue et une resynchronisation nécessaire.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
